#include <iostream>

int main()
{
    int integer1;
    int integer2;
    int integer3;
    int sum;
    printf("please input integer1:\n");
    scanf_s("%d", &integer1);
    printf("please input integer2:\n");
    scanf_s("%d", &integer2);
    printf("please input integer3:\n");
    scanf_s("%d", &integer3);
    sum = integer1 + integer2 + integer3;
    printf("Sum is %d", sum);

    return 0;


    
}

